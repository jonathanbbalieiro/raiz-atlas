# Defina no ambiente da hospedagem (Vercel: Settings > Environment Variables).
# Use a URL real e pública com HTTPS, sem barra final.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Publicação normal: os conteúdos não aprovados ficam ocultos.
RAIZ_PREVIEW_DRAFTS=0

# Opcional, só para scripts de curadoria de fotos (nunca NEXT_PUBLIC_): chave da API do Flickr.
# Crie em https://www.flickr.com/services/apps/create/ e grave em .env.local, nunca aqui.
FLICKR_API_KEY=
